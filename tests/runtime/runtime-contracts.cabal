cabal-version: 3.0
name: runtime-contracts
version: 0.1.0.0
synopsis: Development-only real WASM library contracts
license: BSD-3-Clause
build-type: Simple
data-files: model/storage-bridge.mts

executable library-runtime
  hs-source-dirs: app, ../../support/interop/src, ../../cloudflare-workers/test, ../../servant-cloudflare-workers/test, ../../servant-cloudflare-workers-client/test, ../../servant-cloudflare-workers-access/test, ../../servant-cloudflare-workers-access/internal-src
  main-is: Main.hs
  other-modules: Support.Runtime.Streaming, Support.Runtime.JWKSCache, Servant.Cloudflare.Workers.Access.Internal.JWKS, Servant.Cloudflare.Workers.Access.Internal.JWKSCache, Support.Runtime.Images, Support.Runtime.D1QueryFixture, Support.Runtime.CachePurge, Support.Runtime.WorkersAI, Support.Runtime.PlatformChecks, Support.Runtime.DurableObject.SQLChecks, Support.Runtime.DurableObject.TransactionFixture, Support.Runtime.DurableObject.TransactionLifecycle, Support.Runtime.DurableObject.SQLExecFixture, Support.Runtime.DurableObject.Wait, WorkersSupport.Interop, Support.Runtime.CoreEntrypoints, Support.Runtime.AccessEntrypoints, Support.Runtime.ServantEntrypoints, Support.Cloudflare.Workers.ObservabilityContracts, Support.Runtime.CacheServiceErrors, Support.Runtime.SQLBoundaries, Support.Runtime.TypedQueueBoundaries, Support.Runtime.Envelope, Support.Runtime.MiddlewareExtra, Support.Runtime.StoragePublicContracts, Support.Runtime.StorageObjectErrors, Support.Runtime.StorageErrors, Support.Runtime.WorkflowBoundaryExtra, Support.Runtime.StorageBoundaries, Support.Runtime.SocketStream, Support.Runtime.EntrypointLifecycleErrors, Support.Runtime.TransportExtra, Support.Runtime.BindingEnv, Support.Runtime.EntrypointErrors, Support.Runtime.Routing, Support.Runtime.RoutingCoverage, Support.Runtime.ClientRetryExtra, Support.Runtime.Client, Support.Runtime.AccessRoutes, Support.Runtime.AccessVerification
  default-language: GHC2024
  default-extensions: OverloadedStrings, MultilineStrings
  ghc-options: -Wall
  build-depends: base, cloudflare-workers, containers, time, bytestring, text, aeson, http-media, http-types, servant, servant-client-core, transformers, mtl, servant-cloudflare-workers, servant-cloudflare-workers-client, servant-cloudflare-workers-access, hpc
  if os(wasi)
    build-depends: ghc-experimental >=9.1401 && <9.1500
    default-extensions: JavaScriptFFI
    ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=streamingProbe" "-optl-Wl,--export=jwksCacheScenarios" "-optl-Wl,--export=imagesProbe" "-optl-Wl,--export=d1QueryFixture" "-optl-Wl,--export=cachePurgeExample" "-optl-Wl,--export=workersAIProbe" "-optl-Wl,--export=sqlChecks" "-optl-Wl,--export=upgradeChecks" "-optl-Wl,--export=fetch" "-optl-Wl,--export=storage" "-optl-Wl,--export=cryptoVerify" "-optl-Wl,--export=jwtVerify" "-optl-Wl,--export=jwtVerifyConfigured" "-optl-Wl,--export=d1Lookup" "-optl-Wl,--export=coverage" "-optl-Wl,--export=passThroughContext" "-optl-Wl,--export=waitUntilContext" "-optl-Wl,--export=envelopeProbe" "-optl-Wl,--export=storageNativeProbe" "-optl-Wl,--export=queueOutcome" "-optl-Wl,--export=d1DecoderBoundaries" "-optl-Wl,--export=socketProbe" "-optl-Wl,--export=routingProbe" "-optl-Wl,--export=clientServiceProbe" "-optl-Wl,--export=bindingEnvProbe" "-optl-Wl,--export=accessVerificationProbe" "-optl-Wl,--export=accessRoutesProbe" "-optl-Wl,--export=middlewareExtraProbe" "-optl-Wl,--export=sqlProbe" "-optl-Wl,--export=typedQueueProbe" "-optl-Wl,--export=storageErrorProbe" "-optl-Wl,--export=storageObjectErrors" "-optl-Wl,--export=cacheServiceErrorsProbe" "-optl-Wl,--export=entrypointErrorsProbe" "-optl-Wl,--export=workflowBoundaryExtraProbe" "-optl-Wl,--export=transportExtraProbe" "-optl-Wl,--export=clientRetryExtraProbe" "-optl-Wl,--export=routingCoverageProbe" "-optl-Wl,--export=entrypointLifecycleErrorsProbe" "-optl-Wl,--export=storagePublicContractsProbe"
  else
    buildable: False

test-suite model
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  type: exitcode-stdio-1.0
  hs-source-dirs: test/model, test
  main-is: Spec.hs
  default-language: GHC2024
  default-extensions: OverloadedStrings, MultilineStrings
  other-modules:
    Storage.DurableObjectSpec
    Support.Storage.Model
    Support.Storage.ContractSpec
    Support.Storage.Runtime
    Paths_runtime_contracts
  autogen-modules: Paths_runtime_contracts
  build-tool-depends: testing-support:sydtest-discover-layer
  build-depends:
    base, aeson, bytestring, containers, hedgehog, process, sydtest,
    sydtest-hedgehog, text
