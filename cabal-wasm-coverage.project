import: cabal-wasm.project

-- Instrument authored packages without changing external dependencies.
package cloudflare-workers
  ghc-options: -fhpc -hpcdir .hpc/wasm

package servant-cloudflare-workers
  ghc-options: -fhpc -hpcdir .hpc/wasm

package servant-cloudflare-workers-access
  ghc-options: -fhpc -hpcdir .hpc/wasm

package servant-cloudflare-workers-client
  ghc-options: -fhpc -hpcdir .hpc/wasm

package url-shortener
  flags: +wasm-coverage
  ghc-options: -fhpc -hpcdir .hpc/wasm


package api-catalog
  flags: +wasm-coverage
  ghc-options: -fhpc

package minimal-worker
  flags: +wasm-coverage
  ghc-options: -fhpc

package static-assets-worker
  flags: +wasm-coverage
  ghc-options: -fhpc

package realtime-worker
  flags: +wasm-coverage
  ghc-options: -fhpc

package workflow-example
  flags: +wasm-coverage
  ghc-options: -fhpc

package url-shortener-domain
  ghc-options: -fhpc -hpcdir .hpc/wasm

package url-shortener-infrastructure
  ghc-options: -fhpc -hpcdir .hpc/wasm

package url-shortener-management
  ghc-options: -fhpc -hpcdir .hpc/wasm

package runtime-contracts
  ghc-options: -fhpc -hpcdir .hpc/wasm-library-runtime

package queued-jobs
  flags: +wasm-coverage
  ghc-options: -fhpc
