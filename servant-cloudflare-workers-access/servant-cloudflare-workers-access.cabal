cabal-version: 3.0
name:          servant-cloudflare-workers-access
version:       0.1.0.0
synopsis:
  Cloudflare Zero Trust (Access) authentication for servant-cloudflare-workers

description:
  Adds Cloudflare Access authentication to @servant-cloudflare-workers@.
  The package verifies Access JWT signatures with the Workers SubtleCrypto
  API, validates issuer, audience, time, and token-type claims, caches JWKS
  documents, and exposes a @ZeroTrust@ combinator that supplies verified
  claims to handlers. It targets GHC's @wasm32-wasi@ backend and avoids native
  cryptography dependencies that cannot run in a Worker isolate.

license:       BSD-3-Clause
build-type:    Simple
tested-with:   GHC ==9.14.1

common warnings
  ghc-options: -Wall

library
  import:             warnings
  hs-source-dirs:     src, internal-src
  default-language:   GHC2024
  default-extensions:
    FlexibleContexts
    FlexibleInstances
    KindSignatures
    MultiParamTypeClasses
    MultilineStrings
    OverloadedStrings
    TypeFamilies
    TypeOperators

  exposed-modules:
    Servant.Cloudflare.Workers.Access
    Servant.Cloudflare.Workers.Access.Combinator
    Servant.Cloudflare.Workers.Access.SubtleCrypto

  other-modules:
    Servant.Cloudflare.Workers.Access.Internal.Base64URL
    Servant.Cloudflare.Workers.Access.Internal.Claims
    Servant.Cloudflare.Workers.Access.Internal.Clock
    Servant.Cloudflare.Workers.Access.Internal.Header
    Servant.Cloudflare.Workers.Access.Internal.JWKS
    Servant.Cloudflare.Workers.Access.Internal.JWKSCache

  build-depends:
    , aeson                              >=2.1      && <2.3
    , base                               >=4.22     && <4.23
    , base64-bytestring                  >=1.2      && <1.3
    , bytestring                         >=0.11     && <0.13
    , cloudflare-workers                 ^>=0.1.0.0
    , cloudflare-workers:ghc-wasm-shim
    , servant                            >=0.20     && <0.21
    , servant-client-core                >=0.20     && <0.22
    , servant-cloudflare-workers         ^>=0.1.0.0
    , servant-cloudflare-workers-client  ^>=0.1.0.0
    , text                               >=2.0      && <2.2
    , time                               >=1.15     && <1.16

  if !os(wasi)
    ghc-options: -fplugin GHC.Wasm.FFI.Plugin

  if os(wasi)
    build-depends:      ghc-experimental >=9.1401 && <9.1500
    default-extensions: JavaScriptFFI

test-suite unit
  import: warnings
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  type: exitcode-stdio-1.0
  hs-source-dirs: test/unit, test, internal-src
  main-is: Spec.hs
  default-language: GHC2024
  default-extensions: OverloadedStrings
  build-tool-depends: testing-support:sydtest-discover-layer
  build-depends:
    , time
    , base
    , aeson
    , base64-bytestring
    , bytestring
    , cloudflare-workers
    , containers
    , hedgehog >=1.7 && <1.8
    , http-media
    , http-types
    , servant-client-core
    , sydtest >=0.28 && <0.29
    , sydtest-hedgehog >=0.4 && <0.5
    , text
    , servant-cloudflare-workers-access
    , servant
    , servant-cloudflare-workers
    , transformers
  other-modules:
    Servant.Cloudflare.Workers.Access.Internal.Base64URL
    Servant.Cloudflare.Workers.Access.Internal.ClockSpec
    Servant.Cloudflare.Workers.Access.Internal.Base64URLSpec
    Servant.Cloudflare.Workers.Access.Internal.Claims
    Servant.Cloudflare.Workers.Access.Internal.ClaimsSpec
    Servant.Cloudflare.Workers.Access.Internal.Clock
    Servant.Cloudflare.Workers.Access.Internal.Header
    Servant.Cloudflare.Workers.Access.Internal.JWKS
    Servant.Cloudflare.Workers.Access.Internal.JWKSCache
    Servant.Cloudflare.Workers.Access.Internal.JWKSCacheSpec
    Servant.Cloudflare.Workers.Access.Internal.JWKSSpec
    Support.Fixtures.Claims
    Support.Runtime.JWKSCache
    Support.Runtime.AccessRoutes
    Servant.Cloudflare.Workers.Access.Internal.HeaderSpec
    Servant.Cloudflare.Workers.AccessSpec
    Servant.Cloudflare.Workers.Access.CombinatorSpec
    Support.Fixtures.Combinator
  if !os(wasi)
    build-depends: cloudflare-workers:host-testkit
