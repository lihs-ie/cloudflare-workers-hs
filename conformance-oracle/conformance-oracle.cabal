cabal-version: 3.0
name: conformance-oracle
version: 0.1.0.0
synopsis: Development-only servant-server compatibility oracle
description:
  Provides a development-only reference implementation for comparing
  @servant-cloudflare-workers@ routing and HTTP behavior with
  @servant-server@. It generates golden responses and property-based inputs
  on a host GHC and is intentionally disabled for @wasm32-wasi@ builds.
license: BSD-3-Clause
build-type: Simple
extra-source-files: README.md
data-files: test/Support/Golden/reference.json

common settings
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options: -Wall

library
  import: settings
  hs-source-dirs: src
  exposed-modules: Support.Conformance.Oracle Support.Conformance.Generators
  build-depends:
    , aeson
    , base               >=4.22 && <4.23
    , bytestring
    , case-insensitive
    , hedgehog
    , http-types
    , servant            ==0.20.4.0
    , servant-server     >=0.21 && <0.22
    , text
    , wai
    , wai-extra
  if os(wasi)
    buildable: False

executable regenerate-conformance-golden
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, aeson, bytestring, conformance-oracle
  if os(wasi)
    buildable: False

test-suite unit
  import: settings
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  type: exitcode-stdio-1.0
  hs-source-dirs: test/unit
  main-is: Spec.hs
  other-modules: Conformance.OracleSpec Paths_conformance_oracle
  autogen-modules: Paths_conformance_oracle
  build-tool-depends: testing-support:sydtest-discover-layer
  build-depends: base, aeson, bytestring, conformance-oracle, hedgehog, sydtest, sydtest-hedgehog
  if os(wasi)
    buildable: False
