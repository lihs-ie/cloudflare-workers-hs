#!/usr/bin/env python3
"""Run HLint after masking GHC 9.14 multiline JavaScript FFI strings.

The replacement preserves every newline and the columns of code outside the
multiline string, so HLint diagnostics still point at the original source.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys


FOREIGN_JAVASCRIPT_IMPORT = re.compile(r"\bforeign\s+import\s+javascript\b")
MULTILINE_DELIMITER = '\"\"\"'


def mask_multiline_javascript_ffi(source: str) -> str:
    lines = source.splitlines(keepends=True)
    waiting_for_delimiter = False
    inside_multiline_string = False
    masked_lines: list[str] = []

    for line in lines:
        content = line.rstrip("\r\n")
        newline = line[len(content) :]

        if not waiting_for_delimiter and not inside_multiline_string:
            waiting_for_delimiter = FOREIGN_JAVASCRIPT_IMPORT.search(content) is not None

        if waiting_for_delimiter and not inside_multiline_string:
            opening = content.find(MULTILINE_DELIMITER)
            if opening == -1:
                masked_lines.append(line)
                continue

            closing = content.find(MULTILINE_DELIMITER, opening + len(MULTILINE_DELIMITER))
            if closing == -1:
                replacement = content[:opening] + '\"\"'
                masked_lines.append(replacement.ljust(len(content)) + newline)
                waiting_for_delimiter = False
                inside_multiline_string = True
                continue

            replacement = content[:opening] + '\"\"'
            replacement = replacement.ljust(closing + len(MULTILINE_DELIMITER)) + content[closing + 3 :]
            masked_lines.append(replacement + newline)
            waiting_for_delimiter = False
            continue

        if inside_multiline_string:
            closing = content.find(MULTILINE_DELIMITER)
            if closing == -1:
                masked_lines.append(" " * len(content) + newline)
                continue

            masked_lines.append(" " * (closing + len(MULTILINE_DELIMITER)) + content[closing + 3 :] + newline)
            inside_multiline_string = False
            continue

        masked_lines.append(line)

    return "".join(masked_lines)


def main() -> int:
    real_hlint = os.environ.get("HLINT_REAL") or shutil.which("hlint")
    if not real_hlint:
        print("hlint-multiline-javascript-ffi: hlint was not found", file=sys.stderr)
        return 127

    source = sys.stdin.read()
    completed = subprocess.run(
        [real_hlint, *sys.argv[1:], "-"],
        input=mask_multiline_javascript_ffi(source),
        text=True,
        check=False,
    )
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
