#!/usr/bin/env bash
set -euo pipefail

# HLint 3.10 cannot parse GHC 9.14's JavaScriptFFI multiline strings. Run its
# normal project-wide check, then re-run every multiline-string module through
# the masking wrapper so the surrounding Haskell remains linted as well.
hlint . --ignore='Parse error'

git grep -lz '"""' -- '*.hs' |
    xargs -0 -r -n 1 -P 4 sh -c 'scripts/hlint-multiline-javascript-ffi --no-summary < "$1"' _
