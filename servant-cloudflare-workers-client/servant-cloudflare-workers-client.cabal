cabal-version:   3.0
name:            servant-cloudflare-workers-client
version:         0.1.0.0
synopsis:        Fetch-backed Servant client for Cloudflare Workers
description:
  Generates typed Servant clients that send requests through the Cloudflare
  Workers @fetch@ API. @FetchClient@ implements @RunClient@, allowing the
  standard @HasClient@ and @clientIn@ machinery from @servant-client-core@ to
  construct client functions for Worker applications.
  .
  Use @Servant.Cloudflare.Workers.Client.Fetch@ and
  @Servant.Cloudflare.Workers.Client.Fetch.Request@ as the stable public
  interface. Modules below @Servant.Cloudflare.Workers.Client.Internal@ are
  implementation details and may change between releases.
  .
  The Haskell modules can be type-checked on a host GHC. Executing their
  runtime fetch operations requires a Worker built with GHC's @wasm32-wasi@
  toolchain.

license:         MIT
license-file:    LICENSE
author:          lihs
maintainer:      lihs.dev@gmail.com
copyright:       (c) 2026 lihs
homepage:        https://github.com/lihs-ie/cloudflare-workers-hs
bug-reports:     https://github.com/lihs-ie/cloudflare-workers-hs/issues
category:        Web
build-type:      Simple
tested-with:     GHC ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/lihs-ie/cloudflare-workers-hs.git
  subdir:   servant-cloudflare-workers-client

common warnings
  ghc-options: -Wall

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   GHC2024
  default-extensions:
    CPP
    FlexibleContexts
    FlexibleInstances
    KindSignatures
    MultiParamTypeClasses
    MultilineStrings
    OverloadedStrings
    TypeFamilies
    TypeOperators

  exposed-modules:
    Servant.Cloudflare.Workers.Client.Fetch
    Servant.Cloudflare.Workers.Client.Fetch.Request

  other-modules:
    Servant.Cloudflare.Workers.Client.Internal.FFI.Fetch

  build-depends:
    , base                              >=4.22     && <4.23
    , bytestring                        >=0.11     && <0.13
    , case-insensitive                  >=1.2      && <1.3
    , cloudflare-workers                ^>=0.1.0.0
    , cloudflare-workers:ghc-wasm-shim
    , containers                        >=0.8      && <0.9
    , http-api-data                     >=0.5      && <0.8
    , http-media                        >=0.8      && <0.9
    , http-types                        >=0.12     && <0.13
    , servant                           >=0.20     && <0.21
    , servant-client-core               >=0.20     && <0.22
    , text                              >=2.0      && <2.2
    , transformers                      >=0.5      && <0.7

  if !os(wasi)
    ghc-options: -fplugin GHC.Wasm.FFI.Plugin

  if os(wasi)
    build-depends:      ghc-experimental >=9.1401 && <9.1500
    default-extensions: JavaScriptFFI

test-suite unit
  import: warnings
  ghc-options: -fplugin GHC.Wasm.FFI.Plugin -threaded -rtsopts -with-rtsopts=-N2
  type: exitcode-stdio-1.0
  hs-source-dirs: test/unit, test, src
  main-is: Spec.hs
  default-language: GHC2024
  default-extensions: CPP, MultilineStrings, OverloadedStrings
  build-tool-depends: testing-support:sydtest-discover-layer
  build-depends:
    , base
    , aeson
    , base64-bytestring
    , bytestring
    , case-insensitive
    , cloudflare-workers
    , cloudflare-workers:ghc-wasm-shim
    , containers
    , hedgehog >=1.7 && <1.8
    , http-media
    , http-types
    , servant-client-core
    , servant
    , transformers
    , sydtest >=0.28 && <0.29
    , sydtest-hedgehog >=0.4 && <0.5
    , text
  other-modules:
    Servant.Cloudflare.Workers.Client.Fetch
    Servant.Cloudflare.Workers.Client.Fetch.Request
    Servant.Cloudflare.Workers.Client.Fetch.RequestSpec
    Servant.Cloudflare.Workers.Client.FetchSpec
    Servant.Cloudflare.Workers.Client.Internal.FFI.Fetch
    Servant.Cloudflare.Workers.Client.ServiceBindingSpec
