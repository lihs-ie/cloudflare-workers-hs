{
  "name": "cloudflare-workers-hs-workspace",
  "private": true,
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "test:package": "node scripts/testing/git-runtime-consumer.mts",
    "typecheck": "node scripts/testing/typecheck.mts && tsc -p tsconfig.tools.json",
    "test:tools": "node --experimental-test-module-mocks --test scripts/testing/test/*.spec.mts",
    "build:runtime-tests": "pnpm --dir tests/runtime build:runtime && pnpm --dir examples/url-shortener build:runtime"
  },
  "devDependencies": {
    "@cloudflare-workers-hs/runtime": "catalog:",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-istanbul": "5.1.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-source-maps": "5.0.6",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261113.0-beta",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "type": "module"
}
