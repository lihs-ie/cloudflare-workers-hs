cabal-version: 3.0
name:          servant-cloudflare-workers
version:       0.1.0.0
synopsis:
  Self-implemented Servant server interpreter for Cloudflare Workers

description:
  Server package (ADR-0006/ADR-0019 fork-prohibition): reuses the `servant`
  core type-level DSL (Verb/Capture/QueryParam/Header/ReqBody/:>/:<|>/...) and
  self-implements a HasServer-equivalent interpreter (`HasWorkerServer`)
  against the direct (non-WAI) HTTP types from `cloudflare-workers`. Does NOT
  depend on servant-server / wai / warp / network. This chapter (ch-06-01)
  introduces the package with just the `Handler` monad; `HasWorkerServer`
  (ch-06-02), the real `ServerError` (ch-06-03) and the combinator instances
  (ch-06-04 onward) are added by later chapters.

license:       BSD-3-Clause
build-type:    Simple

common warnings
  ghc-options: -Wall

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   GHC2024
  default-extensions:
    DerivingStrategies
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    MultiParamTypeClasses
    OverloadedStrings
    PolyKinds
    TypeFamilies
    TypeOperators
    UndecidableInstances

  exposed-modules:
    Servant.Cloudflare.Workers.ContentType
    Servant.Cloudflare.Workers.Error
    Servant.Cloudflare.Workers.Handler
    Servant.Cloudflare.Workers.Internal
    Servant.Cloudflare.Workers.Server

  build-depends:
    , base                >=4.16 && <4.22
    , bytestring
    , case-insensitive
    , cloudflare-workers
    , http-api-data
    , mtl
    , servant
    , text
    , transformers

test-suite unit
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  default-language:   GHC2024
  default-extensions:
    DerivingStrategies
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    MultiParamTypeClasses
    OverloadedStrings
    PolyKinds
    TypeFamilies
    TypeOperators
    TypeOperators
    UndecidableInstances

  build-depends:
    , aeson
    , base
    , bytestring
    , cloudflare-workers
    , mtl
    , servant
    , servant-cloudflare-workers
    , tasty
    , tasty-golden
    , tasty-hunit
    , text
    , transformers
