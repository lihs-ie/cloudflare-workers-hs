cabal-version: 3.0
name: minimal-worker
version: 0.1.0.0
synopsis: Minimal NamedRoutes HTTP Worker
license: BSD-3-Clause
build-type: Simple

flag wasm-coverage
  description: Report test-only HPC snapshots after each export invocation
  default: False
  manual: True

executable minimal-worker
  if flag(wasm-coverage)
    if os(wasi)
      build-depends: hpc
      hs-source-dirs: test
      other-modules: Support.Coverage
      cpp-options: -DWASM_COVERAGE
      ghc-options: -fhpc -hpcdir .hpc/wasm-minimal-worker
  hs-source-dirs: app, src
  main-is: Main.hs
  other-modules: Minimal.API, Minimal.Application
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  build-depends: base, aeson, cloudflare-workers, servant, servant-cloudflare-workers, text
  if os(wasi)
    build-depends: ghc-experimental >=9.1401 && <9.1500
    default-extensions: JavaScriptFFI
    ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=fetch"
  else
    build-depends: cloudflare-workers:ghc-wasm-shim
    ghc-options: -fplugin GHC.Wasm.FFI.Plugin
