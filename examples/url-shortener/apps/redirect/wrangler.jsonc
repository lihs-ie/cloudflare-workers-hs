{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "url-shortener-redirect",
  "main": "../../worker/redirect.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "url-shortener",
      "database_id": "a873fdd8-b80e-49f0-9969-fafda0423201",
      "migrations_dir": "../../migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CLICKS",
        "queue": "url-shortener-clicks"
      }
    ]
  }
}
