cabal-version: 3.0
name:          url-shortener
version:       0.1.0.0
synopsis:      Multi-Worker URL shortener using Haskell and Servant
description:
  A multi-Worker URL shortener that demonstrates typed HTTP applications,
  Queues, scheduled handlers, Durable Objects, D1, R2, KV, service bindings,
  and Workflows. It separates shared domain code from Worker infrastructure
  and includes integration tests against the real @wasm32-wasi@ artifacts.

license:       BSD-3-Clause
build-type:    Simple
tested-with:   GHC ==9.14.1

flag wasm-coverage
  description: Collect per-invocation counters in explicit test builds only
  default: False
  manual: True

common warnings
  ghc-options: -Wall

library
  import:             warnings
  hs-source-dirs:     src, apps/redirect/src, apps/export/src, apps/recovery/src,
                      workers/common/src, workers/aggregation/src,
                      workers/export-generation/src, workers/recovery-ingest/src,
                      workers/maintenance/src, workers/export-coordinator/src
  default-language:   GHC2024
  default-extensions: OverloadedStrings
  exposed-modules:
    UrlShortener.Redirect
    UrlShortener.Background.Coordinator
    UrlShortener.Runtime
    UrlShortener.Background.Environment
    UrlShortener.Export.Application
    UrlShortener.Recovery.Application
    UrlShortener.Aggregation.Application
    UrlShortener.ExportGeneration.Application
    UrlShortener.RecoveryIngest.Application
    UrlShortener.Maintenance.Application
  other-modules: UrlShortener.ExportGeneration.Producer

  build-depends:
    , aeson
    , base                        >=4.22 && <4.23
    , bytestring
    , cloudflare-workers
    , containers
    , http-media
    , time
    , url-shortener-domain
    , url-shortener-management
    , url-shortener-infrastructure
    , servant-cloudflare-workers-access
    , mtl
    , servant                     ^>=0.20.3.0
    , servant-cloudflare-workers
    , text

  if os(wasi)
    build-depends: ghc-experimental >=9.1401 && <9.1500
  else
    build-depends: cloudflare-workers:ghc-wasm-shim

test-suite unit
  import:             warnings
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test/unit, test, workers/export-generation/src
  main-is:            Spec.hs
  default-language:   GHC2024
  default-extensions:
    OverloadedStrings
    TypeOperators

  other-modules:
    UrlShortener.Background.CoordinatorSpec
    UrlShortener.ExportGeneration.ProducerSpec
    UrlShortener.ExportGeneration.Producer
  build-tool-depends: testing-support:sydtest-discover-layer

  build-depends: base, bytestring, text, cloudflare-workers, url-shortener, sydtest

executable url-shortener
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  default-language: GHC2024
  build-depends:    base, url-shortener

  if flag(wasm-coverage) && os(wasi)
    hs-source-dirs: test, ../../support/interop/src
    other-modules: WorkersSupport.Interop, Support.Coverage
    build-depends: hpc, text, bytestring, cloudflare-workers
    cpp-options: -DWASM_COVERAGE
    ghc-options: -hpcdir .hpc/wasm-url-shortener

  if os(wasi)
    build-depends:      ghc-experimental >=9.1401 && <9.1500
    default-extensions: JavaScriptFFI
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=fetch" "-optl-Wl,--export=management" "-optl-Wl,--export=exportApi" "-optl-Wl,--export=recovery" "-optl-Wl,--export=aggregation" "-optl-Wl,--export=urlShortenerGeneration" "-optl-Wl,--export=recoveryIngest" "-optl-Wl,--export=maintenance" "-optl-Wl,--export=coordinator" "-optl-Wl,--export=coordinatorAlarm"

  else
    build-depends: cloudflare-workers:ghc-wasm-shim
    ghc-options:   -fplugin GHC.Wasm.FFI.Plugin

-- Development-only reactor: never used by wrangler.jsonc.
executable runtime-tests
  import: warnings
  hs-source-dirs: test/Support/Runtime, test, ../../support/interop/src, workers/export-generation/src
  other-modules: WorkersSupport.Interop, UrlShortener.ExportGeneration.Producer, Support.Runtime.ExportProducer, Support.Runtime.ExportRequestCodec, Support.Runtime.UrlShortenerDatabase, Support.Runtime.GenerationAsync, Support.Runtime.UrlShortenerBoundaries
  main-is: Main.hs
  default-language: GHC2024
  default-extensions: OverloadedStrings
  if flag(wasm-coverage) && os(wasi)
    ghc-options: -hpcdir .hpc/wasm-runtime-tests
  build-depends: base, cloudflare-workers, containers, time, url-shortener, url-shortener-management, url-shortener-infrastructure, bytestring, text, aeson, http-media, http-types, servant, servant-client-core, transformers, mtl, servant-cloudflare-workers, servant-cloudflare-workers-client, servant-cloudflare-workers-access, hpc
  if os(wasi)
    build-depends: ghc-experimental >=9.1401 && <9.1500
    default-extensions: JavaScriptFFI
    ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=coverage" "-optl-Wl,--export=urlShortenerManagementProbe" "-optl-Wl,--export=urlShortenerLeaseProbe" "-optl-Wl,--export=urlShortenerDatabasePreparedProbe" "-optl-Wl,--export=generationAsyncProbe" "-optl-Wl,--export=exportRequestCodecProbe" "-optl-Wl,--export=exportProducerProbe"
  else
    buildable: False
