{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quickstart-management",
  "main": "../../worker/management.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickstart",
      "database_id": "a873fdd8-b80e-49f0-9969-fafda0423201",
      "migrations_dir": "../../migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM": "replace-me",
    "ACCESS_AUDIENCE": "replace-me",
    "ACCESS_JWKS_URL": "https://replace-me.cloudflareaccess.com/cdn-cgi/access/certs"
  }
}
