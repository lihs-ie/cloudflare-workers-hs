cabal-version: 3.0
name:          quickstart
version:       0.1.0.0
synopsis:      URL shortener example fixture for cloudflare-workers-hs
description:
    Non-published example (ADR-0019): the only place in this course with a
  `foreign export javascript "fetch"`. At this stage it only needs to
  build a pure API type (host + wasm32-wasi) and a wasm reactor stub;
  the real "servant-cloudflare-workers" wiring is added from sec-6.

license:       BSD-3-Clause
build-type:    Simple

common warnings
  ghc-options: -Wall

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   GHC2024
  default-extensions: OverloadedStrings
  exposed-modules:
    URLShortener.API
    UrlShortener.DO

  build-depends:
    , aeson
    , base                        >=4.16 && <4.22
    , bytestring
    , cloudflare-workers
    , servant
    , servant-cloudflare-workers
    , text

test-suite unit
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  default-language:   GHC2024
  default-extensions:
    OverloadedStrings
    TypeOperators

  build-depends:
    , aeson
    , base
    , quickstart
    , servant-cloudflare-workers
    , tasty
    , tasty-hunit
    , text

executable quickstart
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  default-language: GHC2024
  build-depends:    base

  if os(wasi)
    build-depends:      ghc-experimental
    default-extensions: JavaScriptFFI
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=fetch"

  else
    buildable: False
