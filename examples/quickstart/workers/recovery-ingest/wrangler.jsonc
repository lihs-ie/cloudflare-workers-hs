{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quickstart-recovery-ingest",
  "main": "../../worker/recovery-ingest.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickstart",
      "database_id": "a873fdd8-b80e-49f0-9969-fafda0423201",
      "migrations_dir": "../../migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "quickstart-clicks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  }
}
