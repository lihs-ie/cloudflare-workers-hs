cabal-version: 3.0
name: quickstart-infrastructure
version: 0.1.0.0
synopsis: Cloudflare persistence adapters for the URL shortener example
description:
  Implements the quickstart URL shortener's persistence operations using
  typed bindings from @cloudflare-workers@. It demonstrates how application
  code can isolate D1 and other Worker storage concerns behind a small
  infrastructure module.
build-type: Simple
license: BSD-3-Clause
library
  hs-source-dirs: src
  exposed-modules: Quickstart.Database
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  build-depends: base, cloudflare-workers, text, time, aeson, bytestring
