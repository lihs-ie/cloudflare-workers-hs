{
  "name": "cloudflare-workers-hs-quickstart",
  "private": true,
  "version": "0.1.0",
  "description": "URL shortener example and real WASM/workerd test harness",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:integration": "vitest run",
    "test:runtime": "vitest run --config vitest.runtime.config.mts",
    "build:runtime": "bash scripts/build-wasm.sh runtime-tests",
    "build:model": "node test/Support/Runtime/build-model.mts",
    "typecheck": "tsc --noEmit",
    "test:runtime:coverage": "vitest run --config vitest.runtime.config.mts --coverage && node test/Support/Runtime/coverage-inventory.mts",
    "test:dev": "node test/Support/Dev/run.mts",
    "test:docker": "python3 ../../scripts/testing/dev-docker.py"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@cloudflare-workers-hs/runtime": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "jsonc-parser": "3.3.1",
    "miniflare": "4.20260722.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0",
    "yaml": "^2.9.0"
  }
}
