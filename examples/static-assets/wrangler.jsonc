{
  "$schema": "../quickstart/node_modules/wrangler/config-schema.json",
  "name": "static-assets-haskell-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" }
}
